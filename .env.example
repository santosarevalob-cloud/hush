# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page. .env.local is gitignored.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free key from https://www.pexels.com/api/ — used for the cover-image search.
VITE_PEXELS_API_KEY=your-pexels-api-key
